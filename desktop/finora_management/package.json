{
  "name": "finora-management-desktop",
  "productName": "FINORA Management",
  "private": true,
  "version": "0.7.2",
  "description": "FINORA Management Desktop â€” orders, purchases and products client for FINORA",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build:audit": "vite build --config vite.audit.config.ts",
    "build": "npm run typecheck && npm run build:electron && npm run build:renderer && npm run build:audit",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"{src,electron,shared,e2e}/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{src,electron,shared,e2e}/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "dist:win10": "npm run build && electron-builder --config electron-builder.win10.json",
    "dist:win7": "npm run build && electron-builder --config electron-builder.win7.json",
    "dist": "npm run build && electron-builder --config electron-builder.win10.json && electron-builder --config electron-builder.win7.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "framer-motion": "11.18.2",
    "lucide-react": "1.52.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sql.js": "1.14.2",
    "zod": "3.25.76",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.49.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "electron": "44.4.5",
    "electron-builder": "25.1.8",
    "esbuild": "0.21.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.13.0",
    "jsdom": "25.0.1",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "tailwindcss": "3.4.19",
    "typescript": "5.6.3",
    "typescript-eslint": "8.71.1",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  },
  "author": "FINORA"
}
