# انسخ هذا الملف إلى .env وعدّل القيم. لا ترفع ملف .env إلى Git.
# Copy this file to .env and set your values. Do not commit .env to Git.

SECRET_KEY=your-secret-key-change-in-production
# قاعدة البيانات: PostgreSQL (إنتاج) أو SQLite (تطوير)
# DATABASE_URL=postgresql://finora:password@localhost/finora_db
DATABASE_URL=sqlite:///database.db
# مطلوب عند تشغيل أكثر من نسخة API: rate limit مشترك + Celery jobs
# REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL=redis://127.0.0.1:6379/1
FLASK_ENV=development

# Meta Graph API release used by Facebook pages, Messenger and publishing.
# Keep this on a currently supported version.
FACEBOOK_API_VERSION=v25.0

# اختياري — البريد (Optional — Mail)
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=
# CONTACT_EMAIL=

# مفاتيح الذكاء الاصطناعي — AI Agent Builder
# OpenAI (من https://platform.openai.com/api-keys)
# لا تضع المفتاح الحقيقي هنا، هذا فقط مثال
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
# موديلات Sales AI مستقلة ويمكن تغيير كل واحد بدون التأثير على البقية
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# القيمة الموثقة حالياً؛ يمكن تغييرها من الإعدادات عند توفر إصدار أحدث للحساب
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TTS_VOICE=coral
OPENAI_TTS_FORMAT=mp3
# OPENAI_TTS_INSTRUCTIONS=تكلم باللهجة العراقية الطبيعية بصوت واضح وودود
OPENAI_VISION_MODEL=gpt-5.4-mini
# تحسين نسخة مؤقتة من صور/PDF الكشف قبل التحليل البصري (الأصل لا يتغير)
WORKSPACE_DOCUMENT_PREPROCESSING_ENABLED=1
# تدوير صفحات كشوف التوصيل الأفقية عند تعذر اكتشاف الاتجاه آلياً
WORKSPACE_DOCUMENT_ROTATE_LANDSCAPE=1
# مهلة التحليل البصري للملفات متعددة الصفحات (ثوانٍ)
WORKSPACE_DOCUMENT_AI_TIMEOUT=300
# medium أسرع ومناسب لاستخراج الجداول؛ يمكن رفعها إلى high للملفات الصعبة
WORKSPACE_DOCUMENT_REASONING_EFFORT=medium
# OPENAI_IMAGE_MODEL=dall-e-3

# Gemini (Google AI Studio — https://aistudio.google.com/)
# ملاحظة: تُستخدم حالياً للتخزين في الإعدادات، ويمكن ربطها لاحقاً كمزوّد إضافي.
GEMINI_API_KEY=replace-with-gemini-api-key
# GEMINI_MODEL=gemini-2.0-flash

# Mobile Social Commerce — optional SMS / Push gateways
# MOBILE_SMS_WEBHOOK_URL=https://sms-gateway.example/send
# MOBILE_SMS_API_KEY=replace-with-provider-key
# MOBILE_ALLOW_LOG_SMS=False  # local development only; never enable in production
# MOBILE_PUSH_WEBHOOK_URL=https://push-gateway.example/send
# MOBILE_PUSH_API_KEY=
# MOBILE_OTP_DEBUG_RETURN_CODE=False  # never expose OTP codes in production
# MOBILE_VIDEO_MAX_MB=200
# في الإنتاج الكبير يجب أن يكون هذا المسار تخزيناً مشتركاً أو object storage
# MOBILE_VIDEO_ROOT=/mnt/finora-mobile-videos

# Local release-build inputs used by Finora Deploy Studio
# FINORA_SOCIAL_API_BASE_URL=https://your-finora-domain.example

# Finora Phone staff companion API uses /api/phone/v1 (employee Bearer tokens).
# Flutter: --dart-define=API_BASE_URL=https://your-finora-domain.example --dart-define=TENANT_SLUG=your_tenant
# FINORA_SOCIAL_TENANT_SLUG=your-tenant-slug

# Finora Social in-app APK updates (bootstrap → app_update)
# Prefer static/downloads/finora-social-version.json written by Publish APK.
# These env vars are the fallback when that file is missing.
# APP_SOCIAL_APK_VERSION=1.2.0
# APP_SOCIAL_APK_BUILD=3
# APP_SOCIAL_APK_MIN_VERSION=1.0.0
# APP_SOCIAL_APK_MIN_BUILD=1
# APP_SOCIAL_APK_URL=/static/downloads/finora-social.apk
# APP_SOCIAL_APK_FORCE=0
# APP_SOCIAL_APK_UPDATE_MESSAGE=يتوفر تحديث جديد لتطبيق Finora. حدّث الآن لتحسين الأداء والحماية.
# APP_PHONE_APK_URL=/static/downloads/finora-phone.apk
# APP_PHONE_APK_VERSION=1.0.11
# APP_PHONE_APK_BUILD=12
# تفعيل رفع تسجيلات المكالمات من تطبيق Finora Phone
# PHONE_FF_RECORDING=true


# WhatsApp Cloud API (Meta)
# احصل على القيم من:
# https://developers.facebook.com/apps/  → WhatsApp → API Setup
# WHATSAPP_ACCESS_TOKEN=EAAG...YourLongToken
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# رقم واتساب فريق Finora الذي يستقبل طلبات تفعيل الحسابات الجديدة
# SIGNUP_WHATSAPP_NUMBER=+9647734049148

# Node AI Automation backend bridge (optional)
# When enabled, /autoposter/api routes proxy to Node service first.
AI_AUTOMATION_NODE_URL=http://127.0.0.1:4000
AI_AUTOMATION_NODE_PROXY=1
# When Node is unavailable, do not run workflow locally (avoids double execution). Set to 1 for emergency fallback.
AI_AUTOMATION_NODE_RUN_FALLBACK=0
# Finora AI provider secrets are encrypted with this server-side key.
# Use a long random value in production and never expose it to the browser/model.
FINORA_AI_ENCRYPTION_KEY=
