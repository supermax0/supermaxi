{
  "id": "refund.record",
  "version": 1,
  "status": "verified",
  "level": 3,
  "title_ar": "استرداد مبلغ",
  "description_ar": "استرداد مبلغ مدفوع على فاتورة إلى المريض.",
  "chip_ar": "التحصيل",
  "requires_permissions": ["clinics_billing"],
  "availability": {"required_features": ["billing"]},
  "curriculum": {"group": "collections", "order": 2},
  "dependencies": [
    {
      "fact": {"name": "refundable_invoices_count", "op": "gt", "value": 0},
      "tutorial": "payment.record",
      "message_ar": "للاسترداد نحتاج فاتورة فيها مبلغ مدفوع فعلاً. ما عندك فاتورة فيها دفعة الآن، نسجل دفعة أولاً ثم نرجع.",
      "action_label_ar": "تسجيل دفعة الآن"
    }
  ],
  "result": "refund.recorded",
  "completion_validator": "refund.recorded_since_start",
  "steps": [
    {
      "id": "open-billing-menu",
      "type": "wait_click",
      "target": { "action": "nav.billing" },
      "reveal": [
        { "action": "nav.menu.open" },
        { "section": "nav.group.finance" }
      ],
      "reconcile": { "kind": "ui", "when": { "page": "billing" } },
      "nav_message_ar": "جاري فتح الفواتير والمدفوعات",
      "message_ar": "الاسترداد يتم من صفحة الفواتير. اضغط «الفواتير»."
    },
    {
      "id": "on-billing-page",
      "type": "navigate",
      "route": "/clinics/billing",
      "page": "billing",
      "reconcile": { "kind": "ui", "when": { "page": "billing" } },
      "message_ar": "نفتح الآن صفحة الفواتير والمدفوعات."
    },
    {
      "id": "check-drawer-open",
      "type": "branch",
      "page": "billing",
      "if": { "exists": { "section": "invoice.drawer" } },
      "then": "click-refund-drawer",
      "else": "click-refund-list"
    },
    {
      "id": "click-refund-drawer",
      "type": "wait_click",
      "page": "billing",
      "target": { "action": "refund.record.drawer" },
      "reconcile": { "kind": "ui", "when": { "visible": { "section": "refund.form" } } },
      "message_ar": "الفاتورة المفتوحة فيها مبلغ مدفوع. اضغط «استرداد» بأسفل تفاصيلها."
    },
    {
      "id": "skip-list",
      "type": "branch",
      "page": "billing",
      "if": { "exists": { "action": "nav.billing" } },
      "then": "amount",
      "else": "amount"
    },
    {
      "id": "click-refund-list",
      "type": "wait_click",
      "page": "billing",
      "target": { "action": "refund.record" },
      "reveal": [
        { "action": "invoice.row_menu.toggle" }
      ],
      "reconcile": { "kind": "ui", "when": { "visible": { "section": "refund.form" } } },
      "message_ar": "اضغط «⋮» ثم «استرداد» على الفاتورة التي فيها مبلغ مدفوع."
    },
    {
      "id": "amount",
      "type": "wait_input",
      "page": "billing",
      "target": { "field": "refund.amount" },
      "condition": { "min_length": 1 },
      "message_ar": "اكتب مبلغ الاسترداد. يمكنك استرداد كامل المبلغ المدفوع أو جزء منه فقط."
    },
    {
      "id": "reason",
      "type": "highlight",
      "page": "billing",
      "target": { "field": "refund.reason" },
      "message_ar": "اكتب سبب الاسترداد للتوثيق. اضغط «فهمت»."
    },
    {
      "id": "save",
      "type": "wait_api_success",
      "page": "billing",
      "allow_back": false,
      "target": { "action": "refund.confirm" },
      "match": { "method": "POST", "url": "^/clinics/api/invoices/\\d+/refund$" },
      "reconcile": { "kind": "backend", "validator": "refund.recorded_since_start" },
      "success_ar": "تم تسجيل الاسترداد.",
      "message_ar": "راجع مبلغ الاسترداد والسبب قبل التأكيد، ثم اضغط «حفظ». أنت من يضغط الحفظ — المدرّس لا ينفذ الاسترداد نيابة عنك."
    },
    {
      "id": "verify",
      "type": "wait_state",
      "allow_back": false,
      "validator": "refund.recorded_since_start",
      "recovery_message_ar": "ما تأكد تسجيل الاسترداد. لا تعيد المحاولة قبل التحقق من حالة الفاتورة — اضغط «تحقق من حالة الفاتورة» وسنتأكد من السجل الحقيقي قبل أي محاولة ثانية.",
      "recovery_retry_label_ar": "تحقق من حالة الفاتورة",
      "message_ar": "نتأكد الآن من تسجيل الاسترداد وتحديث رصيد الفاتورة في النظام…"
    },
    {
      "id": "done",
      "type": "complete",
      "allow_back": false,
      "message_ar": "تم تسجيل الاسترداد وتحديث رصيد الفاتورة، وتأكدنا من ذلك داخل النظام."
    }
  ]
}
