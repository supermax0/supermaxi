# مرفقات مؤقتة
static/uploads/
outputs/
*.tmp
temp/
tmp/

# كاش أدوات محلية (Codex/Cursor) — لا يُرفع مع Smart Deploy
.codex-tmp/
.cursor/
.claude/

# تصدير ترويجي محلي (فيديو 4K) — ليس جزء من التطبيق؛ يمنع تضخيم Smart Deploy
marketing/
output/

# ملفات ثقيلة (تجاوز حد GitHub 100MB)
*.glb

# Desktop installers are deployed as release artifacts (larger than GitHub's file limit).
static/downloads/*.exe
static/downloads/*.apk
*.tsbuildinfo
